<!-- Minimal skid-steer two-wheel robot for the backpack twin.
     Two driven wheels + one passive caster. Tune masses / inertias to
     match your actual LEGO build before relying on sim-to-real. -->
<mujoco model="backpack">
  <option timestep="0.005" gravity="0 0 -9.81"/>

  <default>
    <joint armature="0.001" damping="0.05"/>
    <geom contype="1" conaffinity="1" friction="1.0 0.05 0.001"/>
  </default>

  <worldbody>
    <geom name="floor" type="plane" size="5 5 0.1" rgba="0.85 0.85 0.85 1"/>
    <light pos="0 0 3" dir="0 0 -1" diffuse="0.7 0.7 0.7"/>

    <body name="chassis" pos="0 0 0.04">
      <freejoint/>
      <geom name="chassis" type="box" size="0.08 0.06 0.02" mass="0.4" rgba="0.2 0.4 0.9 1"/>

      <body name="left_wheel" pos="0 0.07 0">
        <joint name="left_wheel" type="hinge" axis="0 1 0"/>
        <geom type="cylinder" size="0.028 0.012" euler="1.5708 0 0" mass="0.05" rgba="0.1 0.1 0.1 1"/>
      </body>

      <body name="right_wheel" pos="0 -0.07 0">
        <joint name="right_wheel" type="hinge" axis="0 1 0"/>
        <geom type="cylinder" size="0.028 0.012" euler="1.5708 0 0" mass="0.05" rgba="0.1 0.1 0.1 1"/>
      </body>

      <body name="caster" pos="-0.07 0 -0.018">
        <joint name="caster" type="ball"/>
        <geom type="sphere" size="0.012" mass="0.02" rgba="0.5 0.5 0.5 1" friction="0.05 0.005 0.0001"/>
      </body>
    </body>
  </worldbody>

  <actuator>
    <velocity name="left_motor"  joint="left_wheel"  kv="0.05" ctrlrange="-30 30"/>
    <velocity name="right_motor" joint="right_wheel" kv="0.05" ctrlrange="-30 30"/>
  </actuator>
</mujoco>
